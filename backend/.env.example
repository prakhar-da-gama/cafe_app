# MySQL connection
DB_USER=root
DB_PASSWORD=prakhar
DB_HOST=localhost
DB_PORT=3306
DB_NAME=food_app

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# SMTP email (GoDaddy / Secureserver). Leave SMTP_HOST blank in local dev to
# log OTPs to the console instead of emailing them.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=admin@ordersbuddy.in
SMTP_PASSWORD=your-mailbox-password
SMTP_FROM=no-reply@ordersbuddy.in
SMTP_USE_TLS=false
SMTP_USE_SSL=true
